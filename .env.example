# ============================================================
# CloudLedger - exemplo de configuração local
# Copie para .env e ajuste os valores. NUNCA versione o .env.
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cloudledger
POSTGRES_USER=cloudledger
POSTGRES_PASSWORD=cloudledger_dev

# ---------- MongoDB (auditoria) ----------
MONGO_URI=mongodb://cloudledger:cloudledger_dev@localhost:27017
MONGO_DATABASE=cloudledger_audit

# ---------- API ----------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=cloudledger;Username=cloudledger;Password=cloudledger_dev
Mongo__ConnectionString=mongodb://cloudledger:cloudledger_dev@localhost:27017
Mongo__Database=cloudledger_audit

# ---------- JWT ----------
# Gere um segredo forte (>= 32 bytes). Ex.: openssl rand -base64 48
Jwt__Issuer=CloudLedger
Jwt__Audience=CloudLedger.Web
Jwt__SigningKey=CHANGE_ME_dev_only_signing_key_at_least_32_chars_long
Jwt__AccessTokenMinutes=60
Jwt__RefreshTokenDays=7

# ---------- CORS ----------
Cors__AllowedOrigins__0=http://localhost:4200

# ---------- AWS / LocalStack ----------
Aws__Region=us-east-1
Aws__ServiceUrl=http://localhost:4566
Aws__UseLocalStack=true
Aws__SqsQueueName=cloudledger-domain-events
Aws__DynamoTableName=cloudledger-idempotency
Aws__S3BucketName=cloudledger-reports
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ---------- Frontend ----------
NG_APP_API_URL=http://localhost:5080/api/v1
