{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Logging": {
    "Json": false
  },
  "HttpsRedirection": {
    "Enabled": true
  },
  "AllowedHosts": "*",
  "Database": {
    "AutoMigrate": false
  },
  "Jwt": {
    "Issuer": "CloudLedger",
    "Audience": "CloudLedger.Web",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Mongo": {
    "Database": "cloudledger_audit"
  },
  "Aws": {
    "Enabled": false,
    "Region": "us-east-1",
    "SqsQueueName": "cloudledger-domain-events",
    "DynamoTableName": "cloudledger-idempotency",
    "S3BucketName": "cloudledger-reports"
  }
}
